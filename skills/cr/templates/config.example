# crosscheck 配置,放在 ~/.crosscheck/config(用 sh config.sh path 查实际位置)
# 每行一个 key=value,# 开头是注释

# 私有化 GitLab:域名里不含 gitlab 时写在这里,多个用逗号分隔;部署在子路径下时写全,如 company.com/gitlab
gitlab_hosts=code.company.com

# 可选:读取非 GitLab 需求单的命令,{key} 会替换成编号,例如 PROJ-231
# issue_cmd=jira issue view {key} --plain

# 可选:模型。核实最好用和查找不同的模型,两者的盲区不同。
# 写当前宿主认识的模型名:下面是 Claude Code 的写法;Codex、Cursor 要写各自的模型名。
# 宿主不支持给子代理指定模型(例如 Cursor 部分计费方案下子代理固定用默认模型)时,照常用宿主的模型运行,报告里会说明。
# model.finder=sonnet
# model.verifier=opus

# 可选:需求来源和 MR 说明网页版。团队统一的设置建议写在插件里的 crosscheck.conf,这里写个人覆盖。
# 按用途分类,每类写读取它用的 skill 或命令名(多个用逗号分隔),怎么调用由 agent 决定。
# source.ticket = <读取需求单的 skill 或命令名>
# source.prd = <读取需求文档的 skill 或命令名>
# source.required = ticket, prd                # 每次都要收集(可跳过)的类别;不写时只有 ticket
# source.ticket.label = <显示名>               # MR 说明里显示的名字
# source.prd.label = PRD
# source.ticket.match = <链接里的关键字>       # 识别链接用;不写时从工具名和显示名推出
# output.page = <发布网页的 skill 或命令名>    # 不写就只生成本地文件
