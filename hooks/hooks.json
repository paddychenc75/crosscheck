{
  "description": "cr 审查进行期间,拦截会改变仓库状态的 git/gh/glab 命令和对仓库文件的编辑",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/cr/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/cr/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
