{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "sh ./skills/cr/scripts/guard.sh"
      }
    ],
    "preToolUse": [
      {
        "command": "sh ./skills/cr/scripts/guard.sh",
        "matcher": "Write|Edit|Delete"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh ./skills/cr/scripts/guard.sh"
      }
    ],
    "beforeReadFile": [
      {
        "command": "sh ./skills/cr/scripts/guard.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": "sh ./skills/cr/scripts/guard.sh"
      }
    ],
    "stop": [
      {
        "command": "sh ./skills/cr/scripts/guard.sh"
      }
    ]
  }
}
