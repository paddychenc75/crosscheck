{
  "description": "Codex:cr 审查进行期间,拦截会改变仓库状态的命令、对仓库文件的编辑,以及可能暴露凭证的命令",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/skills/cr/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/skills/cr/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/skills/cr/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
